{
  "rewrites": [
    { "source": "/terminos", "destination": "/terminos-clientes-1.0.html" },
    { "source": "/terminos-comercios", "destination": "/terminos-comercios-1.0.html" },
    { "source": "/privacidad", "destination": "/privacidad-1.0.html" }
  ],
  "headers": [
    {
      "source": "/brand_assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
